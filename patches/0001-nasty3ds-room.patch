diff --git a/src/citra_libretro/nasty3ds_room.cpp b/src/citra_libretro/nasty3ds_room.cpp
new file mode 100644
index 000000000..709d9e4c2
--- /dev/null
+++ b/src/citra_libretro/nasty3ds_room.cpp
@@ -0,0 +1,189 @@
+// Nasty3DS: local wireless play for the libretro core.
+// The 3DS "local wireless" (UDS) of this emulator goes through a "room": one player hosts a
+// room, the others join it. The libretro core has no way to start one, so the host app calls
+// these functions. They are plain C so a host can find them with dlsym.
+
+#include <atomic>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include "audio_core/hle/hle.h"
+#include "common/logging/log.h"
+#include "core/core.h"
+#include "core/hle/service/cfg/cfg.h"
+#include "network/network.h"
+#include "network/verify_user.h"
+
+namespace {
+std::mutex room_mutex;
+bool network_ready = false;
+std::atomic<int> last_error{-1};
+
+bool EnsureNetwork() {
+    if (!network_ready) {
+        network_ready = Network::Init();
+        if (network_ready) {
+            if (auto member = Network::GetRoomMember().lock()) {
+                member->BindOnError([](const Network::RoomMember::Error& error) {
+                    last_error = static_cast<int>(error);
+                });
+            }
+        }
+    }
+    return network_ready;
+}
+
+int JoinLocked(const char* nickname, const char* address, unsigned short port) {
+    auto member = Network::GetRoomMember().lock();
+    if (!member || !nickname || !address) {
+        return 1;
+    }
+    auto& system = Core::System::GetInstance();
+    if (!system.IsPoweredOn()) {
+        return 2; // a game must run first: the console ID comes from the running system
+    }
+    if (member->IsConnected()) {
+        member->Leave();
+    }
+    last_error = -1;
+    member->Join(nickname, Service::CFG::GetConsoleIdHash(system), address, port, 0,
+                 Network::NoPreferredMac, "", "");
+    return 0;
+}
+} // namespace
+
+extern "C" {
+
+/// Call this before a game loads. The game's wireless service takes its link to the room
+/// member when it starts; with no network at that time, packets never reach the game.
+/// Returns 0, or 1 = the network did not start.
+__attribute__((visibility("default"))) int nasty3ds_room_init(void) {
+    std::scoped_lock lock{room_mutex};
+    return EnsureNetwork() ? 0 : 1;
+}
+
+/// Hosts a room on this machine and joins it. Returns 0, or 1 = network failed,
+/// 2 = no game runs, 3 = the port is in use.
+__attribute__((visibility("default"))) int nasty3ds_room_host(const char* nickname,
+                                                              unsigned short port,
+                                                              unsigned max_players) {
+    std::scoped_lock lock{room_mutex};
+    if (!EnsureNetwork()) {
+        return 1;
+    }
+    auto room = Network::GetRoom().lock();
+    if (!room) {
+        return 1;
+    }
+    if (room->GetState() == Network::Room::State::Open) {
+        room->Destroy();
+    }
+    if (!room->Create("Nasty3DS", "", "", port, "", max_players, nickname ? nickname : "", "", 0,
+                      std::make_unique<Network::VerifyUser::NullBackend>(), {})) {
+        return 3;
+    }
+    const int result = JoinLocked(nickname, "127.0.0.1", port);
+    if (result != 0) {
+        room->Destroy(); // never leave a room open that the app does not know about
+    }
+    return result;
+}
+
+/// Joins a room that another player hosts. Returns 0, 1 or 2 as above. The join is not
+/// finished when this returns: read nasty3ds_room_state.
+__attribute__((visibility("default"))) int nasty3ds_room_join(const char* nickname,
+                                                              const char* address,
+                                                              unsigned short port) {
+    std::scoped_lock lock{room_mutex};
+    if (!EnsureNetwork()) {
+        return 1;
+    }
+    if (auto room = Network::GetRoom().lock();
+        room && room->GetState() == Network::Room::State::Open) {
+        room->Destroy(); // a room that this machine hosts closes before it joins another one
+    }
+    return JoinLocked(nickname, address, port);
+}
+
+/// Leaves the room, and closes it if this machine hosts it.
+__attribute__((visibility("default"))) void nasty3ds_room_leave(void) {
+    std::scoped_lock lock{room_mutex};
+    if (!network_ready) {
+        return;
+    }
+    if (auto member = Network::GetRoomMember().lock(); member && member->IsConnected()) {
+        member->Leave();
+    }
+    if (auto room = Network::GetRoom().lock();
+        room && room->GetState() == Network::Room::State::Open) {
+        room->Destroy();
+    }
+}
+
+/// 0 = not in a room, 1 = joining, 2 = joined. Below 0: -(1 + RoomMember::Error) of the
+/// last failed join (for example -7 = wrong version, -9 = could not connect).
+__attribute__((visibility("default"))) int nasty3ds_room_state(void) {
+    std::scoped_lock lock{room_mutex};
+    if (!network_ready) {
+        return 0;
+    }
+    auto member = Network::GetRoomMember().lock();
+    if (!member) {
+        return 0;
+    }
+    switch (member->GetState()) {
+    case Network::RoomMember::State::Joining:
+        return 1;
+    case Network::RoomMember::State::Joined:
+    case Network::RoomMember::State::Moderator:
+        return 2;
+    default: {
+        const int error = last_error.load();
+        return error >= 0 ? -(1 + error) : 0;
+    }
+    }
+}
+
+/// Writes the nicknames of the players in the room, one per line, into `out`.
+/// Returns how many players are in the room.
+__attribute__((visibility("default"))) int nasty3ds_room_members(char* out, unsigned long length) {
+    std::scoped_lock lock{room_mutex};
+    if (out && length > 0) {
+        out[0] = 0;
+    }
+    if (!network_ready) {
+        return 0;
+    }
+    auto member = Network::GetRoomMember().lock();
+    if (!member || !member->IsConnected()) {
+        return 0;
+    }
+    std::string text;
+    int count = 0;
+    for (const auto& info : member->GetMemberInformation()) {
+        text += info.nickname;
+        text += '\n';
+        count++;
+    }
+    if (out && length > 0) {
+        std::strncpy(out, text.c_str(), length - 1);
+        out[length - 1] = 0;
+    }
+    return count;
+}
+
+/// Call before the core unloads.
+__attribute__((visibility("default"))) void nasty3ds_room_shutdown(void) {
+    std::scoped_lock lock{room_mutex};
+    if (network_ready) {
+        Network::Shutdown();
+        network_ready = false;
+    }
+}
+
+/// The sound of the sound effects only, for the controller rumble. See AudioCore::N3SfxRead.
+__attribute__((visibility("default"))) size_t nasty3ds_sfx_read(int16_t* dst, size_t max_frames) {
+    return AudioCore::N3SfxRead(dst, max_frames);
+}
+
+} // extern "C"
